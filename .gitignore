# Private homelab specifics — node tokens, per-node configs, the seed DB.
# Never commit this folder.
private/
Dev-Docs/

# Optional populated offline-demo data for the dashboard (has real node names).
# The committed UI ships only a generic placeholder demo.
hub/src/picotty/static/demo.json

# Hub runtime data (the SQLite database and WAL sidecars). Runtime state now
# lives outside the source tree (~/.local/share/picotty or a systemd
# StateDirectory); this rule stays for legacy in-tree runs.
hub/data/
*.db
*.db-wal
*.db-shm

# Python build artifacts (uv build / wheels / sdists)
dist/
build/
.python-version.local

# Staged firmware build artifacts (contain the node's real settings.toml)
firmware/build/

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# CircuitPython compile cache (if any lands here)
*.mpy.bak

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp


# Downloaded front-end libs (fetched by the vendor fetch-vendor.sh; bundled into
# the wheel at build time — do not commit the third-party bundles).
hub/src/picotty/static/vendor/*.js
hub/src/picotty/static/vendor/*.css
