# systemd unit for the PICOTTY Telegram sidecar. Placeholders (__USER__,
# __BOTDIR__, __ENVFILE__) are filled in by install-service.sh.
[Unit]
Description=PICOTTY Telegram sidecar
After=network-online.target swarm-hub.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__BOTDIR__
# Credentials + config — the same file the dashboard writes. chmod 600, never in
# the repo. TELEGRAM_ENV_FILE points the sidecar's hot-reload at it too.
EnvironmentFile=__ENVFILE__
Environment=TELEGRAM_ENV_FILE=__ENVFILE__
ExecStart=__BOTDIR__/.venv/bin/python -m app
Restart=on-failure
RestartSec=5

# Hardening — the sidecar needs only outbound network + its own dir.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=__BOTDIR__/data
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
