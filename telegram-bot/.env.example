# PICOTTY Telegram sidecar — copy to .env, chmod 600, fill in, keep out of git.
# This file is the single source of truth for the bot's credentials.

# ---- Telegram (required) ----------------------------------------------------
# From @BotFather. Treat as a full credential for the whole surface.
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric chat ids allowed to talk to the bot. Get yours by
# messaging the bot once and reading the log line, or via @userinfobot. Every
# update is checked against this list; unknown chats get silence.
TELEGRAM_ALLOWED_CHAT_IDS=

# ---- Hub (REST + WebSocket) -------------------------------------------------
# The sidecar's ONLY channel to the hub. Point at the hub's web face on :8080.
HUB_BASE_URL=http://127.0.0.1:8080
# Derived from HUB_BASE_URL if left blank (http->ws, https->wss, /ws path).
#HUB_WS_URL=ws://127.0.0.1:8080/ws
# Only if the hub has auth_enabled; otherwise leave blank.
#HUB_AUTH_PASSWORD=

# ---- Tier 2: alerts ---------------------------------------------------------
ALERTS_ENABLED=true
# Per (kind,node) suppression window in seconds — stops a flapping node spamming.
ALERT_DEBOUNCE_S=180
EVENTS_POLL_INTERVAL_S=15

# ---- Tier 3: terminal bridge (break-glass) ----------------------------------
# Set false to run stats + alerts only (no shell/reboot/sysrq).
SHELL_ENABLED=true
# Base32 TOTP secret shared with your authenticator app. REQUIRED when the shell
# is enabled. Generate one:  python -c "import pyotp;print(pyotp.random_base32())"
# then add it to the app as a manual key (or build an otpauth:// URI).
SHELL_TOTP_SECRET=
# How long a successful /arm keeps the shell usable, and how long an idle session
# survives before auto-closing.
SHELL_ARM_WINDOW_S=3600
SHELL_IDLE_TIMEOUT_S=300

# ---- Output relay tuning (optional) -----------------------------------------
#OUTPUT_FLUSH_INTERVAL_MS=1600
#OUTPUT_MAX_CHUNK=3500
#OUTPUT_SUMMARIZE_BYTES=24000

# ---- Audit ------------------------------------------------------------------
# Append-only JSONL, chmod 600. Records chat id, command, node, outcome.
#AUDIT_LOG_PATH=./data/telegram-audit.jsonl
